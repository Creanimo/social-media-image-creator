<h3>Layers</h3>
<div class="wa-stack" style="gap: 15px;">
    {{#layers}}
    <wa-details class="layer-item" data-index="{{index}}">
        <div slot="summary" style="display: flex; align-items: center; gap: 10px; width: 100%;">
            <wa-icon name="{{layerIcon}}" library="tabler" title="Type: {{type}}" style="font-size: 1.2rem; opacity: 0.7;"></wa-icon>
            <wa-icon name="{{slotIcon}}" library="tabler" title="Alignment: {{slot}}" style="font-size: 1.2rem; opacity: 0.7;"></wa-icon>
            <wa-input name="layer-{{index}}-name" value="{{name}}" size="small" onclick="event.stopPropagation();" onkeydown="if ([' ', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) event.stopPropagation();" style="flex: 1;"></wa-input>
            {{#hasMultipleLayers}}
            <div class="wa-cluster" style="gap: 5px;">
                <wa-button circle size="small" class="move-layer-up-btn" data-index="{{index}}" {{^canMoveUp}}disabled{{/canMoveUp}} onclick="event.stopPropagation();" title="Move Up">
                    <wa-icon name="arrow-up" library="tabler"></wa-icon>
                </wa-button>
                <wa-button circle size="small" class="move-layer-down-btn" data-index="{{index}}" {{^canMoveDown}}disabled{{/canMoveDown}} onclick="event.stopPropagation();" title="Move Down">
                    <wa-icon name="arrow-down" library="tabler"></wa-icon>
                </wa-button>
            </div>
            {{/hasMultipleLayers}}
            <wa-button circle class="remove-layer-btn" data-index="{{index}}" style="color: red;" onclick="event.stopPropagation();">
                <wa-icon name="trash" library="tabler"></wa-icon>
            </wa-button>
        </div>
        
        <div class="wa-stack" style="padding: 10px; border-top: 1px solid #ddd; gap: 15px;">
            <div class="wa-cluster" style="gap: 10px; align-items: center;">
                <wa-text size="small" style="opacity: 0.8;">Overlap:</wa-text>
                <wa-button size="small" class="bring-to-front-btn" data-index="{{index}}" {{#isAtFront}}disabled{{/isAtFront}} onclick="event.stopPropagation();" title="Bring to Front">
                    <wa-icon name="arrow-bar-to-up" library="tabler" slot="start"></wa-icon>
                    Bring to Front
                </wa-button>
                <wa-button size="small" class="send-to-back-btn" data-index="{{index}}" {{#isAtBack}}disabled{{/isAtBack}} onclick="event.stopPropagation();" title="Send to Back">
                    <wa-icon name="arrow-bar-to-down" library="tabler" slot="start"></wa-icon>
                    Send to Back
                </wa-button>
            </div>

            {{#isFont}}
            {{> layer-font}}
            {{/isFont}}
            {{#isIcon}}
            {{> layer-icon}}
            {{/isIcon}}
            {{#isIconCallout}}
            {{> layer-icon-callout}}
            {{/isIconCallout}}
            {{#isImage}}
            {{> layer-image}}
            {{/isImage}}
        </div>
    </wa-details>
    {{/layers}}
    
    <div class="wa-cluster" style="gap: 10px;">
        <wa-button id="add-layer-btn" variant="primary">
            <wa-icon name="plus" library="tabler" slot="start"></wa-icon>
            Add Layer
        </wa-button>
    </div>
</div>
