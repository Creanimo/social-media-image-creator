<div class="wa-stack" style="gap: 10px;">
    <wa-text size="small"><strong>Select Logo</strong></wa-text>
    <div class="logo-selection-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); gap: 5px; max-height: 150px; overflow-y: auto; padding: 5px; border: 1px solid var(--wa-color-neutral-200); border-radius: var(--wa-border-radius-medium); background: #f0f0f0;">
        {{#availableLogos}}
        <div class="logo-card {{#isActive}}active{{/isActive}}" data-logo-id="{{id}}" data-layer-index="{{layerIndex}}" style="cursor: pointer; border: 2px solid {{#isActive}}var(--wa-color-primary-600){{/isActive}}{{^isActive}}transparent{{/isActive}}; border-radius: 4px; padding: 2px; background: white; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center;">
            <img src="{{src}}" alt="{{name}}" title="{{name}}" style="max-width: 100%; max-height: 100%; object-fit: contain;">
        </div>
        {{/availableLogos}}
    </div>
    <input type="hidden" name="layer-{{index}}-logoId" value="{{logoId}}">

    <wa-select name="layer-{{index}}-slot" label="Slot" value="{{slot}}" size="small">
        <wa-option value="top-left">Top Left</wa-option>
        <wa-option value="top-middle">Top Middle</wa-option>
        <wa-option value="top-right">Top Right</wa-option>
        <wa-option value="center-left">Center Left</wa-option>
        <wa-option value="center-middle">Center Middle</wa-option>
        <wa-option value="center-right">Center Right</wa-option>
        <wa-option value="bottom-left">Bottom Left</wa-option>
        <wa-option value="bottom-middle">Bottom Middle</wa-option>
        <wa-option value="bottom-right">Bottom Right</wa-option>
    </wa-select>

    <div class="wa-flank:end">
        <wa-slider class="layer-slider" data-index="{{index}}" data-type="width" label="Width" name="layer-{{index}}-width" value="{{width}}" min="0" max="{{creation.widthTimesTwo}}" step="1" with-tooltip></wa-slider>
        <wa-button variant="neutral" circle size="small" class="reset-slider-btn" data-target="layer-{{index}}-width" data-default="200" style="margin-top: 25px;">
            <wa-icon name="reset" library="tabler"></wa-icon>
        </wa-button>
    </div>

    <div class="wa-flank:end">
        <wa-slider class="layer-slider" data-index="{{index}}" data-type="opacity" label="Opacity" name="layer-{{index}}-opacity" value="{{opacity}}" min="0" max="100" step="1" with-tooltip></wa-slider>
        <wa-button variant="neutral" circle size="small" class="reset-slider-btn" data-target="layer-{{index}}-opacity" data-default="100" style="margin-top: 25px;">
            <wa-icon name="reset" library="tabler"></wa-icon>
        </wa-button>
    </div>

    <div class="wa-flank:end">
        <wa-slider class="layer-slider" data-index="{{index}}" data-type="offsetX" label="Offset X" name="layer-{{index}}-offsetX" value="{{offsetX}}" min="-{{creation.width}}" max="{{creation.width}}" step="1" with-tooltip></wa-slider>
        <wa-button variant="neutral" circle size="small" class="reset-slider-btn" data-target="layer-{{index}}-offsetX" data-default="0" style="margin-top: 25px;">
            <wa-icon name="reset" library="tabler"></wa-icon>
        </wa-button>
    </div>
    <div class="wa-flank:end">
        <wa-slider class="layer-slider" data-index="{{index}}" data-type="offsetY" label="Offset Y" name="layer-{{index}}-offsetY" value="{{offsetY}}" min="-{{creation.height}}" max="{{creation.height}}" step="1" with-tooltip></wa-slider>
        <wa-button variant="neutral" circle size="small" class="reset-slider-btn" data-target="layer-{{index}}-offsetY" data-default="0" style="margin-top: 25px;">
            <wa-icon name="reset" library="tabler"></wa-icon>
        </wa-button>
    </div>
</div>
