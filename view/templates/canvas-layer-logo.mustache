{{#src}}
<div class="canvas__slot canvas__slot--{{slot}} logo-layer" 
     data-index="{{index}}"
     style="z-index: {{zIndex}}; width: {{width}}px; opacity: {{opacityValue}};">
    <div style="transform: translate({{offsetX}}px, {{offsetY}}px);">
        <img src="{{src}}" 
             class="logo-layer__img"
             style="width: {{width}}px; object-fit: contain; image-rendering: high-quality;" />
    </div>
</div>
{{/src}}
